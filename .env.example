# FLOPSHOW Backend Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development: SQLite file path (active default for local development)
DATABASE_PATH=./backend/data/flopshow.db

# Production Database: PostgreSQL connection URL (e.g., Supabase, Neon, Render PostgreSQL)
# Format: postgresql://username:password@host:port/database?sslmode=require
# Set DATABASE_URL in your production deployment environment (Render, Railway, Fly.io, etc.).
# For local development with SQLite, leave this empty or commented out.
# DATABASE_URL=postgresql://postgres:your_password@ep-sample-12345.region.aws.neon.tech/flopshow?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=flopshow_super_secret_dev_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Dedicated Administrator Direct Login Credentials
ADMIN_ID=Admin
ADMIN_PASSWORD="Kataria2005#"

# Development Admin Seed Configuration
# Leave DEV_ADMIN_PASSWORD empty to auto-generate a secure temporary password during db:seed
DEV_ADMIN_EMAIL=admin@flopshow.tv
DEV_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# METADATA & UPLOADS
# ------------------------------------------------------------------------------
TMDB_API_KEY=
OMDB_API_KEY=trilogy
# UPLOAD_DIR=./backend/uploads

VITE_API_BASE_URL=https://flop-show.onrender.com
FRONTEND_URL=https://flop-show-4a14.onrender.com,https://flop-show.netlify.app

