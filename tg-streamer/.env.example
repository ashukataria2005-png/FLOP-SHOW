# ============================================================
#  Telegram File Streaming Bot — Environment Variables
#  Copy this file to .env and fill in the values.
# ============================================================

# ------------------------------------------------------------------
# Telegram API credentials (get from https://my.telegram.org/apps)
# ------------------------------------------------------------------
API_ID=123456
API_HASH=your_api_hash_here

# ------------------------------------------------------------------
# Bot token (get from @BotFather on Telegram)
# ------------------------------------------------------------------
BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ

# ------------------------------------------------------------------
# Private Telegram channel ID used as the media storage bin.
# The bot must be an admin with "Post Messages" permission.
# Format: negative integer, e.g. -1001234567890
# ------------------------------------------------------------------
BIN_CHANNEL=-1001234567890

# ------------------------------------------------------------------
# Public base URL of this server (no trailing slash).
# Used to construct streaming links sent back to users.
# Example: https://mystreamer.example.com
# ------------------------------------------------------------------
FQDN=https://mystreamer.example.com

# ------------------------------------------------------------------
# Server binding options
# ------------------------------------------------------------------
PORT=8080
WEB_SERVER_BIND_ADDRESS=0.0.0.0
